#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR"

# 兼容维护者现有命令，同时保持仓库可移植：
# - jenv 存在时读取项目 .java-version；
# - 其他环境直接使用调用者配置的 JAVA_HOME / PATH；
# - Maven 版本和下载逻辑统一由官方 Wrapper 管理。
if command -v jenv >/dev/null 2>&1; then
  exec jenv exec ./mvnw "$@"
fi

exec ./mvnw "$@"
