# AnalyticsHub backend environment example.
# AnalyticsHub 单实例运行配置。
# 所有 replace-with-* 都必须替换；check-app.sh 会拦截这些 placeholder。

SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=3001
LOG_PATH=/var/log/analyticshub
LOG_FILE=analyticshub
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=512MB

# AnalyticsHub 自身系统库。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=analytics
DB_SCHEMA=analytics
DB_USER=analytic
DB_PASSWORD=replace-with-database-password

# 管理接口 token。首次 setup 会自动生成强随机值。
ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Base64-encoded 32-byte AES key for connected-project database passwords.
# setup-app.sh generates this for a new installation. Back it up separately.
PROJECT_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
PROJECT_CREDENTIAL_PREVIOUS_ENCRYPTION_KEY=

# 邮件告警，可选。test/prod 日志会脱敏这些字段。
MAIL_ENABLED=false
MAIL_HOST=smtpdm.aliyun.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# Milliseconds. Keep each timeout well below the outbox claim timeout.
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
ALERT_EMAIL=

# Transactional work-order outbox. Defaults are suitable for one instance;
# tune these only after considering SMTP capacity and retry requirements.
WORK_ORDER_OUTBOX_SCHEDULER_ENABLED=true
WORK_ORDER_OUTBOX_SCHEDULER_INITIAL_DELAY_MS=30000
WORK_ORDER_OUTBOX_SCHEDULER_FIXED_DELAY_MS=60000
WORK_ORDER_OUTBOX_SCHEDULER_BATCH_SIZE=20
WORK_ORDER_OUTBOX_CLAIM_TIMEOUT_SECONDS=300
WORK_ORDER_OUTBOX_RETRY_DELAY_SECONDS=60

APP_SECURITY_2FA_ENABLED=false
APP_SECURITY_2FA_SECRET=
APP_SECURITY_TRUSTED_PROXIES=127.0.0.1,::1
APP_SECURITY_MAX_REQUEST_BODY_BYTES=1048576
CREDENTIAL_ROTATION_GRACE_SECONDS=600
# Unsafe compatibility escape hatch. Keep false in production.
ALLOW_INSECURE_DEVICE_REREGISTRATION=false

# Internal actor-link clients. Each service ID, Project ID, and HMAC secret must
# be unique. Use loopback while the business backends run on the same host.
ACTOR_LINK_ENABLED=true
ACTOR_LINK_REQUIRE_LOOPBACK=true
ACTOR_LINK_SIGNATURE_VALIDITY_MS=300000
APP_SECURITY_ACTOR_LINK_CLIENTS_0_SERVICE_ID=replace-with-test-service-id
APP_SECURITY_ACTOR_LINK_CLIENTS_0_PROJECT_ID=replace-with-test-project-id
APP_SECURITY_ACTOR_LINK_CLIENTS_0_SECRET=replace-with-test-random-secret-at-least-32-chars
APP_SECURITY_ACTOR_LINK_CLIENTS_1_SERVICE_ID=replace-with-prod-service-id
APP_SECURITY_ACTOR_LINK_CLIENTS_1_PROJECT_ID=replace-with-prod-project-id
APP_SECURITY_ACTOR_LINK_CLIENTS_1_SECRET=replace-with-prod-random-secret-at-least-32-chars

# JSON parser resource guards. Keep these positive and below the JVM memory
# budget; HMAC request bodies are additionally capped by the byte limit above.
APP_JSON_MAX_NESTING_DEPTH=64
APP_JSON_MAX_STRING_LENGTH=262144
APP_JSON_MAX_NUMBER_LENGTH=128

# Comma-separated. Use the real frontend origin in production; "*" is only a
# convenient default when no browser credentials/cookies are involved.
APP_CORS_ALLOWED_ORIGINS=*
APP_CORS_ALLOW_CREDENTIALS=false
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_REQUESTS=100
# The application requires a fixed window of at least 1000 milliseconds.
APP_RATE_LIMIT_WINDOW_MS=60000

# Public traffic endpoints are intentionally usable without a token. Configure
# these when the deployment needs a shared token or stable privacy-preserving IP hashes.
TRAFFIC_PUBLIC_TOKEN=
TRAFFIC_IP_HASH_SALT=

PROJECT_DATASOURCE_MAXIMUM_POOL_SIZE=5
PROJECT_DATASOURCE_MINIMUM_IDLE=0
